{
  "manifest_version": 3,
  "name": "Image Switcher Extension",
  "version": "1.0.0",
  "description": "A Chrome extension to switch hero images on a webpage.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Image Switcher Extension",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"]
    }
  ]
}
